{
    /** Visita https://aka.ms/tsconfig para leer más sobre este archivo */
    "compilerOptions": {
        "rootDir": ".", // Directorio raíz de los archivos fuente
        "outDir": "./build", // Directorio de salida para los archivos compilados
        "module": "ESNext", // Sistema de módulos a utilizar
        "moduleResolution": "node",
        "target": "es2020", // Versión de ECMAScript a utilizar
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "lib": [
            "esnext"
        ], // Incluye las definiciones de tipo de ESNext
        "types": [
            "node"
        ], // e instalar npm install -D @types/node
        "sourceMap": true, // Genera archivos de mapa de origen para facilitar la depuración
        "declaration": true, //
        "declarationMap": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitReturns": true, // Requiere que todas las funciones tengan un valor de retorno
        "noImplicitOverride": true, // Requiere que las funciones sobreescritas sean explícitas
        "noUnusedLocals": true, // Requiere que todas las variables locales sean utilizadas
        "noUnusedParameters": true, // Requiere que todos los parámetros de función sean utilizados
        "noFallthroughCasesInSwitch": true, // Requiere que todos los casos en switch sean manejados
        "noPropertyAccessFromIndexSignature": true, // Requiere que no se acceda a propiedades a través de firmas de índice
        /** Opciones recomendadas */
        /** Activa todas las opciones de verificación estricta de tipos */
        "strict": true,
        /** Requiere sintaxis explícita de importación de tipos */
        "verbatimModuleSyntax": true,
        /** Asegura que cada archivo pueda ser transpilado de forma independiente */
        "isolatedModules": true,
        /** Requiere que todas las importaciones sean verificadas */
        "noUncheckedSideEffectImports": true,
        /** Fuerza a tratar todos los archivos como módulos */
        "moduleDetection": "force",
        /** Omite la verificación de tipos en archivos de declaración de librerías (mejora rendimiento) */
        "skipLibCheck": true,
        "emitDeclarationOnly": true,
        "allowImportingTsExtensions": true
    }
}
